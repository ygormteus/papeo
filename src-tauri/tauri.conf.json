{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papeo",
  "version": "0.11.1",
  "identifier": "io.github.ygormteus.papeo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "SocialNetworking",
    "publisher": "Ygor Moura",
    "copyright": "© 2026 Ygor Moura · github.com/ygormteus",
    "homepage": "https://github.com/ygormteus/papeo",
    "shortDescription": "Mensageiros num só lugar, leve e rápido",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5NjAzNDM5NTFFNTUyMDUKUldRRlV1VlJPVFJnS1RTTFlzR2dYT1ZDRDhvWVFRdnVWQkJaZnpIM0ZuRnEzUzBsTzdtR253bTAK",
      "endpoints": [
        "https://github.com/ygormteus/papeo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
