{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Interface do Papeo (webview local `ui`). As webviews dos serviços não entram aqui.",
  "webviews": ["ui"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "opener:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-get-state",
    "allow-add-service",
    "allow-remove-service",
    "allow-customize-service",
    "allow-move-service",
    "allow-set-hibernation",
    "allow-set-notifications",
    "allow-mute-service",
    "allow-set-media-policy",
    "allow-set-zoom",
    "allow-activate-service",
    "allow-hibernate-service",
    "allow-open-chat",
    "allow-reload-service",
    "allow-set-content-area",
    "allow-set-overlay",
    "allow-set-dnd",
    "allow-set-quiet-hours",
    "allow-set-preferences",
    "allow-set-autostart",
    "allow-set-downloads-dir",
    "allow-reveal-download",
    "allow-open-downloads-dir",
    "allow-clear-downloads",
    "allow-get-memory",
    "allow-export-config",
    "allow-preview-backup",
    "allow-import-config",
    "allow-clear-service-data",
    "allow-get-orphan-sessions",
    "allow-clean-orphan-sessions",
    "allow-set-lock",
    "allow-lock-now",
    "allow-unlock",
    "allow-set-appearance",
    "allow-check-update",
    "allow-install-update",
    "allow-set-updates",
    "allow-get-organizer",
    "allow-save-task",
    "allow-set-task-done",
    "allow-snooze-task",
    "allow-delete-task",
    "allow-save-note"
  ]
}
